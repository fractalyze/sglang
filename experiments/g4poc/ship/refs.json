{
  "ship-inflight": {
    "description": "SHIP: the in-flight config of G4POC-DEPLOY.md (final-hc-cp2048-lpm + glue + c1) on the ship branch jumanzii/g4poc-ship, flags written out with no SGLANG_MOE_CONFIG_DIR (the C1 MoE config ships in the default config dir). Same flags and env as final-hc-cp2048-lpm-glue-c1 (tree cfc12c0bac) after argparse's last-wins. 28G scope.",
    "commit": "e652f30b1df33a4c77a82ebbfcae2f75a82cde44",
    "server_args": [
      "--kv-cache-dtype",
      "fp8_e4m3",
      "--context-length",
      "16384",
      "--json-model-override-args",
      "{\"max_position_embeddings\": 16384}",
      "--disable-prefill-cuda-graph",
      "--max-running-requests",
      "64",
      "--mem-fraction-static",
      "0.955",
      "--swa-full-tokens-ratio",
      "0.268",
      "--cuda-graph-max-bs-decode",
      "48",
      "--enable-hierarchical-cache",
      "--hicache-size",
      "12",
      "--hicache-write-policy",
      "write_through",
      "--hicache-io-backend",
      "kernel",
      "--hicache-mem-layout",
      "page_first",
      "--chunked-prefill-size",
      "2048",
      "--schedule-policy",
      "lpm"
    ],
    "env": {
      "SGLANG_OPT_GEMMA4_FP8_VOCAB_TABLE": "1",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
